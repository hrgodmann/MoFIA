TITLE:    BFI2 configural (Model4_conf in ../MoFIA/MoFIA_Comp.R)
DATA:     FILE = "../datasets/BFI2.dat";
VARIABLE: NAMES = i4 i19 i34 i49 i9 i24 i39 i54 Gender Age;
          USEVARIABLES = i4 i19 i34 i49 i9 i24 i39 i54 Age Gender;
          CATEGORICAL = i4 i19 i34 i49 i9 i24 i39 i54;
          CONSTRAINT = Age Gender;
ANALYSIS: TYPE = GENERAL;
          ESTIMATOR = MLR;
          INFORMATION = OBSERVED;
          LINK = LOGIT;
          ALGORITHM = INTEGRATION;
          LOGCRITERION = 0.00001;
MODEL:
  [Anxiety@0];
  [Depress@0];
  Anxiety* (fv1);
  Depress* (fv2);
  Anxiety BY i4*;
  Anxiety BY i19* (ld2_1);
  Anxiety BY i34* (ld3_1);
  Anxiety BY i49* (ld4_1);
  Depress BY i9*;
  Depress BY i24* (ld6_2);
  Depress BY i39* (ld7_2);
  Depress BY i54* (ld8_2);
  Anxiety ON Age Gender;
  Depress ON Age Gender;
  Anxiety WITH Depress* (cv12);
  i19 ON Age Gender;
  i34 ON Age Gender;
  i49 ON Age Gender;
  i24 ON Age Gender;
  i39 ON Age Gender;
  i54 ON Age Gender;
MODEL CONSTRAINT:
  NEW(l2_1_0*1 l2_1_a*0 l2_1_g*0 l3_1_0*1 l3_1_a*0 l3_1_g*0 l4_1_0*1 l4_1_a*0
      l4_1_g*0 l6_2_0*1 l6_2_a*0 l6_2_g*0 l7_2_0*1 l7_2_a*0 l7_2_g*0 l8_2_0*1
      l8_2_a*0 l8_2_g*0 z12_0*0.3 z12_a*0 z12_g*0 d1_a*0 d1_g*0 d2_a*0
      d2_g*0);
  ld2_1 = l2_1_0 + l2_1_a*Age + l2_1_g*Gender;
  ld3_1 = l3_1_0 + l3_1_a*Age + l3_1_g*Gender;
  ld4_1 = l4_1_0 + l4_1_a*Age + l4_1_g*Gender;
  ld6_2 = l6_2_0 + l6_2_a*Age + l6_2_g*Gender;
  ld7_2 = l7_2_0 + l7_2_a*Age + l7_2_g*Gender;
  ld8_2 = l8_2_0 + l8_2_a*Age + l8_2_g*Gender;
  cv12 = (EXP(2*(z12_0 + z12_a*Age + z12_g*Gender)) - 1) / (EXP(2*(z12_0 +
      z12_a*Age + z12_g*Gender)) + 1) * EXP((d1_a*Age + d1_g*Gender + d2_a*Age
      + d2_g*Gender)/2);
  fv1 = EXP(d1_a*Age + d1_g*Gender);
  fv2 = EXP(d2_a*Age + d2_g*Gender);
